# On the host this becomes /srv/apps/heic-webp-converter/deploy/.env (install.sh creates it
# on the first deploy). Never commit a filled-in copy.

# Public name of the API. Point its DNS A record at the host's IP before
# deploying, so Caddy can get a certificate.
APP_DOMAIN=

# Stripe: a restricted key that can read Checkout Sessions (rk_live_...).
STRIPE_SECRET_KEY=
# The Stripe Payment Link for the unlock. Set its "after payment" redirect to
#   https://<APP_DOMAIN>/thanks?session_id={CHECKOUT_SESSION_ID}
PAYMENT_LINK_URL=
# The Ed25519 key that signs licence keys lives in deploy/secrets/ on the host
# as license-signing-key.pem (copy it from server/deploy/secrets/ on the PC
# that built the app). The app only accepts keys signed by it.
